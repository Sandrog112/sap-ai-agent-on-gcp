# Copy to .env (git-ignored) and fill in, then run commands with: uv run --env-file .env <command>
# GCP credentials come from `gcloud auth application-default login`, so none are stored here.
#
# The stack is deployed with Terraform, which reads terraform/terraform.tfvars, not this file. These settings are for
# running data_preprocessing/upload_to_gcp.py by hand (to reload the sales data with --replace) and for a local run of
# the agent. Use the same values as in terraform.tfvars.

GCP_PROJECT_ID=your-project-id
GCP_REGION=europe-west1
CLOUD_SQL_INSTANCE=sap-sales
DB_NAME=sap_sales

# The database admin, used on your machine only: the deployed services sign in to Cloud SQL with their service accounts.
DB_USER=postgres
DB_PASSWORD=

# The Google AI Studio API key (https://aistudio.google.com/api-keys) of the router, Gemini Decision 1. Only needed for a
# local run of the agent: the deployed agent reads it from Secret Manager, where Terraform stores it.
GEMINI_API_KEY=
