# Copy to .env (git-ignored) and fill in, then run commands with: uv run --env-file .env <command>
# GCP credentials come from `gcloud auth application-default login`, so none are stored here.

GCP_PROJECT_ID=your-project-id
# Region of the Cloud SQL instance, the Cloud Run service and the Agent Runtime.
GCP_REGION=europe-west1
# deploy.py creates the instance if it does not exist; an existing one must be in GCP_REGION and have the database
# flag cloudsql.iam_authentication=on.
CLOUD_SQL_INSTANCE=sap-sales
DB_NAME=sap_sales

# The database admin. Only deploy.py and upload_to_gcp.py use it, on your machine: the deployed services sign in to
# Cloud SQL with their service accounts, so this password never reaches them.
DB_USER=postgres
DB_PASSWORD=

# Optional: leave empty for the defaults in agent/config.py.
ROUTER_MODEL=
SIMPLE_MODEL=
COMPLEX_MODEL=
GEMINI_LOCATION=
MEMORY_LOCATION=

# Optional: "true" switches on the failure scenarios of backend/faults.py, for demonstrating retries and traces.
FAULT_INJECTION=
